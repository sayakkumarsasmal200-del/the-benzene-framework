#the benzene framework
import turtle

pen = turtle.Turtle()

for heading,distance in [(150, 60), (90, 80), (30, 60), (-30, 60), (-90, 80)]:
    pen.setheading(heading)
    pen.forward(distance) 
pen.goto(0,0) 
pen.penup()
pen.setheading(90) 
pen.forward(70)
pen.right(90)
pen.forward(40)
pen.setheading(90)
pen.pendown()
pen.circle(40)
